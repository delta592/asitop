{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "configMigration": true,
    "extends": [
        "github>delta592/renovate-config/default.json"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": false
    },
    "packageRules": [
        {
            "description": "Pin Python runtime to 3.14.x (matches pyproject.toml)",
            "matchManagers": [
                "pyenv"
            ],
            "matchPackageNames": [
                "python"
            ],
            "allowedVersions": "/^3\\.14(\\.\\d+)?$/"
        }
    ]
}
